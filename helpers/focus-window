#!/bin/bash
# Focus a Hyprland window by address, after the overlay has a moment to unmap.
# Address must already be a compositor id. No shell metacharacters are accepted.
# An optional second address is one that blur-focus disarmed. Both get their
# no_focus and focus_on_activate overrides cleared before the focus, so a
# stashed client can take the seat again and a different stashed client is
# not left unable to focus. The picked window is also raised to the top of
# its z-order, so it lands in front of any overlapping floating windows.
#
# The focus dispatch itself warps the pointer unless cursor.no_warps is on.
# This turns it on for the focus, then asks blur-focus to reconcile. Reconcile
# turns it off when the grid has disarmed, and leaves it on when a newer open
# armed again, so a delayed focus cannot leave the option stuck.
set -euo pipefail

normalize() {
  local value=$1
  value=${value#address:}
  if [[ $value != 0x* && $value != 0X* ]]; then
    value=0x${value}
  fi
  if [[ ! $value =~ ^0x[0-9a-fA-F]{1,32}$ ]]; then
    echo "nitty-griddy: refusing to focus an address that is not a window id" >&2
    return 2
  fi
  printf '%s' "$value"
}

if [[ $# -lt 1 || $# -gt 2 ]]; then
  echo "nitty-griddy: refusing to focus an address that is not a window id" >&2
  exit 2
fi

address=$(normalize "$1") || exit 2
release=""
if [[ $# -eq 2 ]]; then
  release=$(normalize "$2") || exit 2
fi

delay="${NITTY_GRIDDY_FOCUS_DELAY:-0.18}"
if [[ ! $delay =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  delay=0.18
fi
sleep "$delay"

clear_call() {
  local target=$1
  printf " hl.dispatch(hl.dsp.window.set_prop({ prop = 'no_focus', value = 'unset', window = 'address:%s' })); hl.dispatch(hl.dsp.window.set_prop({ prop = 'focus_on_activate', value = 'unset', window = 'address:%s' }));" "$target" "$target"
}

# no_warps stays true through the focus dispatch. Reconcile applies the
# grid's current intent afterwards (false once dismiss has disarmed).
body=" hl.config({ cursor = { no_warps = true } });"
body+=$(clear_call "$address")
if [[ -n $release && $release != "$address" ]]; then
  body+=$(clear_call "$release")
fi
body+=" hl.dispatch(hl.dsp.focus({ window = 'address:${address}' }));"
body+=" hl.dispatch(hl.dsp.window.alter_zorder({ mode = 'top', window = 'address:${address}' }));"

script="(function()${body} end)()"
if ! hyprctl eval "$script" >/dev/null 2>&1; then
  hyprctl dispatch "hl.dsp.exec_cmd('hyprctl keyword cursor:no_warps true')" >/dev/null 2>&1 || true
  hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"no_focus\", value = \"unset\", window = \"address:${address}\" })" >/dev/null 2>&1 || true
  hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"focus_on_activate\", value = \"unset\", window = \"address:${address}\" })" >/dev/null 2>&1 || true
  if [[ -n $release && $release != "$address" ]]; then
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"no_focus\", value = \"unset\", window = \"address:${release}\" })" >/dev/null 2>&1 || true
    hyprctl dispatch "hl.dsp.window.set_prop({ prop = \"focus_on_activate\", value = \"unset\", window = \"address:${release}\" })" >/dev/null 2>&1 || true
  fi
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 || true
  hyprctl dispatch "hl.dsp.window.alter_zorder({ mode = \"top\", window = \"address:$address\" })" >/dev/null 2>&1 || true
fi

"$(dirname "$0")/blur-focus" --reconcile-no-warps || true

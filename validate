#!/bin/bash
# Local stand-in for `omarchy plugin validate .`, plus helper behavior.
# On an Omarchy machine, also run: omarchy plugin validate .
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

fail() {
  echo "validate: $*" >&2
  exit 1
}

command -v jq >/dev/null || fail "jq is required"
[[ -f manifest.json ]] || fail "missing manifest.json"
jq -e . manifest.json >/dev/null || fail "manifest.json is not valid JSON"
jq -e '.schemaVersion == 1' manifest.json >/dev/null || fail "schemaVersion must be the number 1"
for field in id name version kinds entryPoints; do
  jq -e --arg f "$field" 'has($f)' manifest.json >/dev/null || fail "missing $field"
done

id=$(jq -r '.id' manifest.json)
[[ $id == "timsonner.nitty-griddy" ]] || fail "id is '$id', expected timsonner.nitty-griddy"
[[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || fail "invalid plugin id"
[[ $id != omarchy.* ]] || fail "reserved id"

jq -e '.name == "NittyGriddy"' manifest.json >/dev/null || fail "display name"
jq -e '.kinds == ["overlay"]' manifest.json >/dev/null || fail "kinds must be [\"overlay\"]"
jq -e '.keepLoaded == true' manifest.json >/dev/null || fail "keepLoaded must be true"
jq -e '.entryPoints.overlay == "Overview.qml"' manifest.json >/dev/null || fail "overlay entry"
[[ -f Overview.qml && ! -L Overview.qml ]] || fail "Overview.qml missing or a symlink"

while IFS= read -r ep_json; do
  [[ -n $ep_json ]] || continue
  ep=$(jq -r '.' <<<"$ep_json")
  [[ $ep != /* && $ep != *..* && -f $ep && ! -L $ep ]] || fail "unsafe entry point: $ep"
done < <(jq -c '.entryPoints | to_entries[] | .value' manifest.json)

# The shell refuses a plugin tree that contains a symlink.
while IFS= read -r path; do
  [[ -L $path ]] && fail "symlink not allowed: $path"
done < <(find . -mindepth 1 \( -path './.git' -prune \) -o -print)

for helper in helpers/focus-window helpers/close-window helpers/list-windows helpers/blur-focus; do
  [[ -f $helper && -x $helper ]] || fail "$helper must be an executable file"
  bash -n "$helper"
done
bash -n validate

qml=Overview.qml
for token in \
  'function open' 'function close' 'function dismiss' \
  'timsonner.nitty-griddy:open' 'timsonner.nitty-griddy:close' \
  'Key_Escape' 'close-selected' 'closeSelected' \
  'focus-window' 'close-window' 'blur-focus' 'priorAddress' 'Text.PlainText' \
  'shell.hide' 'ScreencopyView'
do
  grep -q -- "$token" "$qml" || fail "Overview.qml missing $token"
done

grep -q 'direction = "up"' gestures.snippet.lua || fail "gesture up"
grep -q 'direction = "down"' gestures.snippet.lua || fail "gesture down"
grep -q 'timsonner.nitty-griddy:open' gestures.snippet.lua || fail "gesture open event"
grep -q 'timsonner.nitty-griddy:close' gestures.snippet.lua || fail "gesture close event"
grep -q 'workspace = "r-1"' gestures.snippet.lua || fail "gesture previous workspace"
grep -q 'workspace = "r+1"' gestures.snippet.lua || fail "gesture next workspace"
grep -q 'timsonner.nitty-griddy:workspace-prev' gestures.snippet.lua || fail "gesture workspace prev"
grep -q 'timsonner.nitty-griddy:workspace-next' gestures.snippet.lua || fail "gesture workspace next"
grep -q 'timsonner.nitty-griddy:workspace-prev' Overview.qml || fail "overview workspace prev"
grep -q 'timsonner.nitty-griddy:workspace-next' Overview.qml || fail "overview workspace next"
grep -q 'function stepWorkspace' Overview.qml || fail "overview stepWorkspace"
# Comments may warn about the flag. An actual assignment must not.
if grep -vE '^[[:space:]]*--' gestures.snippet.lua | grep -q 'omarchy_default_gestures'; then
  fail "snippet must not set omarchy_default_gestures"
fi
# Unset is a config error when up and down are not already registered.
if grep -vE '^[[:space:]]*--' gestures.snippet.lua | grep -q 'action = "unset"'; then
  fail "snippet must not register action = unset"
fi
grep -q 'shell summon' gestures.snippet.lua || fail "snippet should document summon fallback"
grep -q 'shell hide' gestures.snippet.lua || fail "snippet should document hide fallback"
grep -q 'shell toggle' bindings.snippet.lua || fail "keybind should toggle via shell IPC"
grep -q 'SUPER + W' bindings.snippet.lua || fail "Super+W close bind"
grep -q 'timsonner.nitty-griddy:close-selected' bindings.snippet.lua || fail "close-selected event"
grep -q 'omarchy plugin add' README.md || fail "README install"
grep -q 'gestures.lua' README.md || fail "README gestures path"
grep -q 'omarchy restart shell' README.md || fail "README shell restart"
grep -q 'omarchy_default_gestures = false' README.md || fail "README must warn against disabling default gestures"
grep -q 'shell summon timsonner.nitty-griddy' README.md || fail "README summon"
grep -q 'shell hide timsonner.nitty-griddy' README.md || fail "README hide"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# The helper ignores a state path that does not end with its own file name.
export NITTY_GRIDDY_WARP_STATE=$tmp/timsonner.nitty-griddy.no-warps
export NITTY_GRIDDY_SPECIAL_STATE=$tmp/timsonner.nitty-griddy.specials
mkdir -p "$tmp/bin"
cat >"$tmp/bin/hyprctl" <<'SH'
#!/bin/bash
printf '%s\n' "$*" >>"${HYPRCTL_LOG:?}"
if [[ ${1:-} == "-j" && ${2:-} == "clients" ]]; then
  python3 -c 'import json; print(json.dumps([
    {"address":"0xabc","mapped":True,"class":"org.wezfurlong.kitty","initialClass":"kitty","title":"shell\none","workspace":{"id":1,"name":"1"}},
    {"address":"0xdef","mapped":False,"class":"ghost","title":"hidden","workspace":{"id":2,"name":"2"}},
    {"address":"0x123","mapped":True,"class":"firefox","title":"docs","workspace":{"id":3,"name":"web"}}
  ]))'
fi
if [[ ${1:-} == "activewindow" && ${2:-} == "-j" ]]; then
  if [[ -n ${HYPRCTL_ACTIVE_JSON+x} ]]; then
    printf '%s\n' "$HYPRCTL_ACTIVE_JSON"
  else
    printf '%s\n' '{"address":"0xabc"}'
  fi
fi
exit 0
SH
chmod +x "$tmp/bin/hyprctl"

log=$tmp/focus.log
HYPRCTL_LOG=$log NITTY_GRIDDY_FOCUS_DELAY=0 PATH="$tmp/bin:$PATH" ./helpers/focus-window 0xAbC
grep -q "hl.dsp.focus" "$log" || fail "focus did not dispatch"
grep -q "address:0xAbC" "$log" || fail "focus address was rewritten or dropped"
if HYPRCTL_LOG=$tmp/bad.log NITTY_GRIDDY_FOCUS_DELAY=0 PATH="$tmp/bin:$PATH" ./helpers/focus-window '0xabc;touch /tmp/nitty-griddy-pwn' ; then
  fail "focus accepted a non-address"
fi
[[ ! -e /tmp/nitty-griddy-pwn ]] || fail "focus executed injected shell"
rm -f /tmp/nitty-griddy-pwn

log=$tmp/close.log
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/close-window 0xabc
grep -q 'hl.dsp.window.close' "$log" || fail "close did not dispatch"
grep -q 'address:0xabc' "$log" || fail "close address missing"
if HYPRCTL_LOG=$tmp/bad-close.log PATH="$tmp/bin:$PATH" ./helpers/close-window '$(reboot)' ; then
  fail "close accepted a non-address"
fi

log=$tmp/list.log
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/list-windows >"$tmp/list.out"
[[ $(wc -l <"$tmp/list.out") -eq 2 ]] || fail "list-windows should emit two mapped clients"
grep -q '"address":"0xabc"' "$tmp/list.out" || fail "list missing kitty"
grep -q 'shell one' "$tmp/list.out" || fail "newline in a title was not flattened"
grep -q '"address":"0x123"' "$tmp/list.out" || fail "list missing firefox"
if grep -q 'ghost' "$tmp/list.out"; then
  fail "unmapped client leaked"
fi
# Each record is one JSON line. A raw newline inside a title would split it.
python3 - "$tmp/list.out" <<'PY' || fail "list-windows output was not clean NDJSON"
import json, sys
lines = open(sys.argv[1], encoding="utf-8").read().splitlines()
if len(lines) != 2:
    raise SystemExit(f"expected 2 json lines, got {len(lines)}")
for line in lines:
    row = json.loads(line)
    for value in row.values():
        if isinstance(value, str) and ("\n" in value or "\r" in value):
            raise SystemExit("newline survived inside a field")
PY

# A non-numeric focus delay must not be passed to sleep.
log=$tmp/delay.log
HYPRCTL_LOG=$log NITTY_GRIDDY_FOCUS_DELAY='1;touch /tmp/nitty-griddy-delay' PATH="$tmp/bin:$PATH" ./helpers/focus-window 0x1
[[ ! -e /tmp/nitty-griddy-delay ]] || fail "focus delay was evaluated"
rm -f /tmp/nitty-griddy-delay

# focus-window clears blur props, then focuses. A second address is released too.
log=$tmp/focus-release.log
HYPRCTL_LOG=$log NITTY_GRIDDY_FOCUS_DELAY=0 PATH="$tmp/bin:$PATH" ./helpers/focus-window 0xAbC 0x123
grep -q "hl.dsp.focus" "$log" || fail "focus with a stashed address did not dispatch"
grep -q "address:0xAbC" "$log" || fail "focus target missing when releasing a stash"
grep -q "address:0x123" "$log" || fail "stashed address was not released"
grep -q "no_focus" "$log" || fail "focus did not clear no_focus"
grep -q "unset" "$log" || fail "focus did not unset the blur props"
if HYPRCTL_LOG=$tmp/bad-second.log NITTY_GRIDDY_FOCUS_DELAY=0 PATH="$tmp/bin:$PATH" ./helpers/focus-window 0x1 '0xabc;touch /tmp/nitty-griddy-pwn2'; then
  fail "focus accepted a non-address as the stashed window"
fi
[[ ! -e /tmp/nitty-griddy-pwn2 ]] || fail "focus executed an injected second address"
rm -f /tmp/nitty-griddy-pwn2

log=$tmp/blur.log
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/blur-focus 0xAbC >"$tmp/blur.out"
grep -q "release_input_capture" "$log" || fail "blur did not release input capture"
grep -q "no_focus" "$log" || fail "blur did not set no_focus"
grep -q "focus_on_activate" "$log" || fail "blur did not set focus_on_activate"
grep -q "address:0xAbC" "$log" || fail "blur address was rewritten or dropped"
grep -q "value = '1'" "$log" || fail "blur did not enable no_focus"
grep -q "value = '0'" "$log" || fail "blur did not disable focus_on_activate"
if grep -q 'hl.dsp.focus(' "$log"; then
  fail "blur focused a window"
fi
[[ $(tr -d '[:space:]' <"$tmp/blur.out") == "0xAbC" ]] || fail "blur did not print the address it disarmed"
if HYPRCTL_LOG=$tmp/bad-blur.log PATH="$tmp/bin:$PATH" ./helpers/blur-focus '0xabc;touch /tmp/nitty-griddy-pwn3'; then
  fail "blur accepted a non-address"
fi
[[ ! -e /tmp/nitty-griddy-pwn3 ]] || fail "blur executed injected shell"
rm -f /tmp/nitty-griddy-pwn3

log=$tmp/blur-active.log
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/blur-focus >"$tmp/blur-active.out"
grep -q "address:0xabc" "$log" || fail "blur did not read the active window"
[[ $(tr -d '[:space:]' <"$tmp/blur-active.out") == "0xabc" ]] || fail "blur did not report the active window"

log=$tmp/blur-none.log
HYPRCTL_LOG=$log HYPRCTL_ACTIVE_JSON='{}' PATH="$tmp/bin:$PATH" ./helpers/blur-focus >"$tmp/blur-none.out"
[[ ! -s "$tmp/blur-none.out" ]] || fail "blur printed an address when nothing was focused"
if grep -q "no_focus" "$log"; then
  fail "blur dispatched when nothing was focused"
fi

log=$tmp/blur-bad-active.log
HYPRCTL_LOG=$log HYPRCTL_ACTIVE_JSON='{"address":"$(reboot)"}' PATH="$tmp/bin:$PATH" ./helpers/blur-focus >"$tmp/blur-bad-active.out"
[[ ! -s "$tmp/blur-bad-active.out" ]] || fail "blur printed a non-address from activewindow"
if grep -q "no_focus" "$log"; then
  fail "blur dispatched a non-address from activewindow"
fi

log=$tmp/release.log
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/blur-focus --release 0xabc >"$tmp/release.out"
grep -q "no_focus" "$log" || fail "release did not touch no_focus"
grep -q "focus_on_activate" "$log" || fail "release did not touch focus_on_activate"
grep -q "unset" "$log" || fail "release did not unset blur props"
[[ ! -s "$tmp/release.out" ]] || fail "release printed an address"
if grep -q 'hl.dsp.focus(' "$log"; then
  fail "release focused a window"
fi
if grep -q "release_input_capture" "$log"; then
  fail "release captured input again"
fi
if HYPRCTL_LOG=$tmp/bad-release.log PATH="$tmp/bin:$PATH" ./helpers/blur-focus --release '$(reboot)'; then
  fail "release accepted a non-address"
fi

# The magnet fix: arm cursor:no_warps while the grid is up, and disarm after.
for token in 'armNoWarps' 'disarmNoWarps' '--grid-open' '--grid-dismiss' 'no_warps'; do
  grep -q -- "$token" "$qml" || fail "Overview.qml missing $token"
done
log=$tmp/warp.log
: >"$log"
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/blur-focus --arm-no-warps --gen 1 >"$tmp/arm.out" 2>"$tmp/arm.err"
grep -q "no_warps = true" "$log" || fail "arm did not enable no_warps"
grep -q "nitty-griddy: arm no_warps" "$tmp/arm.err" || fail "arm did not log"
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/blur-focus --disarm-no-warps --gen 2 >"$tmp/disarm.out" 2>"$tmp/disarm.err"
grep -q "no_warps = false" "$log" || fail "disarm did not clear no_warps"
grep -q "nitty-griddy: disarm no_warps" "$tmp/disarm.err" || fail "disarm did not log"
if HYPRCTL_LOG=$tmp/bad-warp.log PATH="$tmp/bin:$PATH" ./helpers/blur-focus --arm-no-warps --gen '1;reboot'; then
  fail "arm accepted a non-numeric generation"
fi

# A plugin reload restarts the QML counter at 1. A disarmed state file from
# earlier in this login must not make that arm a no-op.
printf '90 off 0\n' >"$NITTY_GRIDDY_WARP_STATE"
touch -d '10 seconds ago' "$NITTY_GRIDDY_WARP_STATE"
log=$tmp/warp-reload.log
: >"$log"
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/blur-focus --arm-no-warps --gen 1 >"$tmp/arm-reload.out" 2>"$tmp/arm-reload.err"
grep -q "no_warps = true" "$log" || fail "reload arm was blocked by an old generation"
if grep -q "arm no_warps stale" "$tmp/arm-reload.err"; then
  fail "reload arm logged stale against an old disarmed generation"
fi
# A dismiss that landed during this open still beats an older in-flight arm.
printf '6 off 0\n' >"$NITTY_GRIDDY_WARP_STATE"
log=$tmp/warp-race.log
: >"$log"
HYPRCTL_LOG=$log PATH="$tmp/bin:$PATH" ./helpers/blur-focus --arm-no-warps --gen 5 >"$tmp/arm-race.out" 2>"$tmp/arm-race.err"
grep -q "arm no_warps stale" "$tmp/arm-race.err" || fail "in-flight arm was not stale after a newer disarm"
if grep -q "no_warps = true" "$log"; then
  fail "stale arm turned no_warps back on"
fi

echo "validate: all checks passed"
